# app-instrumentation — environment template.
#   cp .env.example .env   (then edit; .env is gitignored)
#
# Shared by all four demo stacks (logging / metrics-prom / metrics-otel /
# traces). Each stack's Alloy container reads this file. Leave everything
# unset to keep using the bundled local backends (Loki / Prometheus / Tempo +
# Grafana). Fill in a section to forward that signal to a remote backend
# (your Mimir/Loki/Tempo or Grafana Cloud) instead.

# --- Logs -> Loki (logging stack) ---
# Grafana Cloud: Connections -> Loki -> "Sending logs".
LOGS_PRIMARY_URL=
LOGS_PRIMARY_USER=
LOGS_PRIMARY_PASSWORD=

# --- Metrics -> Prometheus/Mimir remote_write (metrics-prom stack) ---
# Grafana Cloud: Connections -> Prometheus -> "Sending metrics".
METRICS_PRIMARY_URL=
METRICS_PRIMARY_USER=
METRICS_PRIMARY_PASSWORD=

# --- Metrics -> OTLP/HTTP (metrics-otel stack) ---
# Mimir `/otlp` or a Grafana Cloud OTLP gateway. TLS is chosen from the URL
# scheme. METRICS_OTLP_AUTH is the full Authorization header value, e.g.
#   Basic <base64(instanceID:token)>
# Generate it with:  printf '%s' 'INSTANCE_ID:TOKEN' | base64
METRICS_OTLP_URL=
METRICS_OTLP_AUTH=

# --- Traces -> OTLP/gRPC (traces stack) ---
# Remote Tempo / Grafana Cloud OTLP endpoint, e.g. tempo-prod-XX.grafana.net:443
# Set TRACES_TLS_INSECURE=false for a TLS endpoint. TRACES_OTLP_AUTH as above.
TRACES_OTLP_URL=
TRACES_OTLP_AUTH=
TRACES_TLS_INSECURE=true

# --- Optional labels added to every metric/log series ---
CLUSTER_NAME=
ENV=

# --- Image version pins (optional overrides) ---
GRAFANA_ALLOY_VERSION=v1.17.0
GRAFANA_VERSION=13.0.2
