// ###############################################
// #### OpenTelemetry tracing pipeline (push model) ####
// ###############################################
//
// The five online-store services each emit standalone traces using their
// language's OpenTelemetry SDK. Alloy receives the spans over OTLP, batches
// them, and forwards them to Tempo.
//
//   apps ──(OTLP)──▶ Alloy ──(OTLP)──▶ Tempo ──▶ Grafana
//                                        │
//                                        └─(service-graph / span metrics)─▶ Prometheus
//
// gRPC is used by Python, Go, Java, and C# (http://alloy:4317).
// HTTP/protobuf is used by Node.js (http://alloy:4318).

otelcol.receiver.otlp "default" {
  grpc { } // 4317 - Python, Go, Java, C#
  http { } // 4318 - Node.js

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    // Local Tempo (gRPC) by default. Set TRACES_OTLP_URL to a remote Tempo /
    // Grafana Cloud OTLP endpoint (e.g. tempo-prod-XX.grafana.net:443) and
    // TRACES_TLS_INSECURE=false to enable TLS for it.
    endpoint = coalesce(sys.env("TRACES_OTLP_URL"), "tempo:4317")

    // Auth for remote endpoints. Set TRACES_OTLP_AUTH to e.g.
    //   "Basic <base64(instanceID:token)>"
    // Empty for the bundled local Tempo.
    headers = {
      "Authorization" = sys.env("TRACES_OTLP_AUTH"),
    }

    tls {
      insecure = coalesce(sys.env("TRACES_TLS_INSECURE"), "true") == "true"
    }
  }
}
