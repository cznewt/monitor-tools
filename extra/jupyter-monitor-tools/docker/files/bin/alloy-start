#!/usr/bin/env bash
# Start Alloy in the background on a config file or a directory of *.alloy files.
#
#   alloy-start                          your Alloy: /source/work/alloy on :12345
#   alloy-start <port>                   your Alloy on that port
#   alloy-start <file or dir> [port]     another config, on the first free port from 12346
#
# Your Alloy is every *.alloy file in /source/work/alloy ($ALLOY_MAIN_DIR) run as
# one config; an empty directory first gets the course's base files - the Mimir
# and Loki endpoints - from $ALLOY_SEED_DIR. $ALLOY_CONFIG replaces the default
# config and $ALLOY_PORT the default port. A config that is running already is
# validated and reloaded in place, unless another port is asked for. Alloy runs
# detached from the notebook kernel until alloy-stop; its UI is
# /proxy/absolute/<port>/graph behind jupyter-server-proxy. State lives in
# $ALLOY_STATE_DIR (default /tmp/alloy-lab), logs in $ALLOY_LOG_DIR (default
# /source/work/logs/alloy).
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/alloy-lib"

case "${1:-}" in -h|--help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;; esac
arg="${1:-}"
port="${2:-${ALLOY_PORT:-}}"
if [ -n "$arg" ] && [ -z "${arg//[0-9]/}" ]; then port="$arg"; arg=""; fi   # a port alone

if [ -n "$arg" ]; then
  config=$(readlink -f "$arg")
  [ -e "$config" ] || die "no such config: $arg"
elif [ -n "${ALLOY_CONFIG:-}" ]; then
  config=$(readlink -f "$ALLOY_CONFIG")
  [ -e "$config" ] || die "no such config: \$ALLOY_CONFIG=$ALLOY_CONFIG"
else
  mkdir -p "$MAIN_DIR"
  config=$(readlink -f "$MAIN_DIR")
  if ! compgen -G "$config/*.alloy" >/dev/null; then
    compgen -G "$SEED_DIR/*.alloy" >/dev/null || die "no *.alloy in $MAIN_DIR yet, and no base files in $SEED_DIR to begin with"
    for f in "$SEED_DIR"/*.alloy; do [ -e "$config/${f##*/}" ] || cp "$f" "$config/"; done
    echo "$MAIN_DIR was empty - copied the base files from $SEED_DIR: $(cd "$config" && echo *.alloy)"
  fi
fi
[ "$config" = "$(readlink -f "$MAIN_DIR")" ] && port="${port:-$MAIN_PORT}"

where() {
  [ -d "$config" ] && echo "  files:  $(cd "$config" && echo *.alloy)"
  cat <<EOF
  UI:     /proxy/absolute/$1/graph on your notebook host
  logs:   $(log_of "$1")
  reload: alloy-reload $1      stop: alloy-stop $1
EOF
}

alloy validate "$config" >/dev/null 2>"$STATE_DIR/validate.err" || { cat "$STATE_DIR/validate.err" >&2; die "alloy validate failed for $config"; }

# the same config running already: reloaded where it runs, unless another port is asked for
same=""
for p in $(managed_ports); do
  [ "$(cat "$STATE_DIR/$p.config")" = "$config" ] || continue
  if [ -z "$port" ] || [ "$port" = "$p" ]; then
    out=$(curl -s -m 30 -X POST "http://127.0.0.1:$p/-/reload" 2>&1) && echo "$out" | grep -qi reloaded \
      || die "alloy on :$p runs $config but did not reload: ${out:-no answer} - alloy-stop $p, then alloy-start"
    echo "alloy on :$p (pid $(cat "$STATE_DIR/$p.pid")) runs $config already - reloaded"
    where "$p"
    exit 0
  fi
  same="$same $p"
done
# check the port before stopping anything, so a failed start leaves the running Alloys alone
if [ -n "$port" ] && [ ! -f "$STATE_DIR/$port.pid" ] && listening "$port"; then
  for pid in $(unmanaged_pids); do
    [ "$(pid_port "$pid")" = "$port" ] && die "port $port is used by an alloy started by hand (pid $pid) - alloy-stop $port stops it"
  done
  die "port $port is in use by another process"
fi
for p in $same; do stop_port "$p"; done
if [ -n "$port" ]; then
  stop_port "$port"
else
  # the first free one after your Alloy's port, which stays free for it
  port=$((MAIN_PORT + 1))
  while listening "$port" || [ -f "$STATE_DIR/$port.pid" ]; do port=$((port + 1)); done
fi

log="$LOG_DIR/alloy-$port.log"
rm -f "${STATE_DIR:?}/${port:?}.pid"
# a session of its own, so it outlives the notebook kernel; the shell writes its
# pid and then becomes alloy, so the pid file always names the alloy process
setsid bash -c 'echo $$ >"$0"; exec alloy run "$@"' "$STATE_DIR/$port.pid" \
  --server.http.listen-addr="127.0.0.1:$port" \
  --server.http.ui-path-prefix="/proxy/absolute/$port" \
  --storage.path="$STATE_DIR/$port.data" \
  "$config" >"$log" 2>&1 </dev/null &
for _ in $(seq 1 20); do [ -s "$STATE_DIR/$port.pid" ] && break; sleep 0.1; done
pid=$(cat "$STATE_DIR/$port.pid")
echo "$config" >"$STATE_DIR/$port.config"
echo "$log" >"$STATE_DIR/$port.log"

for _ in $(seq 1 30); do
  if ready "$port"; then break; fi
  kill -0 "$pid" 2>/dev/null || { tail -20 "$log" >&2; rm -f "${STATE_DIR:?}/${port:?}."{pid,config,log}; die "alloy exited, log: $log"; }
  sleep 1
done
ready "$port" || { tail -20 "$log" >&2; die "alloy on :$port is not ready after 30 s, log: $log"; }

echo "alloy on :$port (pid $pid) - $config"
where "$port"
