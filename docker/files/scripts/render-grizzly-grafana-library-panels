#!/bin/bash

CONFIG_FILE="${CONFIG_FILE:=/config/default.yaml}"
VENDOR_DIR="/scripts/vendor"
SOURCE_DIR="${SOURCE_DIR:=/source/default}"
BUILD_DIR="${BUILD_DIR:=/build/default/grizzly/grafana-library-panels}"

if [ ! -f "$CONFIG_FILE" ]; then echo "Error: Config file $CONFIG_FILE does not exist."; exit 1; fi

# extra -J paths a mixin declares (config: mixins.<key>.jpaths, relative to
# the mixin dir) — e.g. vendor/github.com/cznewt/observ-viz so a vendored
# repo's own relative imports resolve.
extra_jpaths() {
  yq eval -o=json -I=0 ".mixins.\"$1\".jpaths // []" "$CONFIG_FILE" 2>/dev/null | jq -r '.[]?' | while read -r p; do
    [ -n "$p" ] && printf ' -J %s' "$mixinDir/$p"
  done
}
keys=$(yq eval -o=json -I=0 '.mixins | keys' "$CONFIG_FILE" 2>/dev/null | jq -r '.[]?')

for key in $keys; do
  if [ "$key" = "-" ]; then continue; fi
  mixinDir="$SOURCE_DIR/mixins/$key-mixin"
  if [ -d "$mixinDir/vendor" ]; then
      echo "Rendering $mixinDir grizzly GrafanaLibraryPanels with vendor to $BUILD_DIR..."
      jsonnet -c -S -m $BUILD_DIR -J $VENDOR_DIR -J "$mixinDir/vendor" $(extra_jpaths "$key") \
      -e "(import 'cbm.libsonnet').grizzlyGrafanaLibraryPanels('$key', (import '$mixinDir/mixin.libsonnet'), std.parseYaml(importstr '$CONFIG_FILE'))"
  else
      echo "Rendering $mixinDir grizzly GrafanaLibraryPanels to $BUILD_DIR..."
      jsonnet -c -S -m $BUILD_DIR -J $VENDOR_DIR $(extra_jpaths "$key") \
      -e "(import 'cbm.libsonnet').grizzlyGrafanaLibraryPanels('$key', (import '$mixinDir/mixin.libsonnet'), std.parseYaml(importstr '$CONFIG_FILE'))"
  fi
done
