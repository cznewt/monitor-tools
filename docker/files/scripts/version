#!/bin/bash
# Print the version of every tool bundled in the image, one per line.
# Each tool spells its version differently, so the invocation is per entry and
# the output is trimmed to its first non-empty line. Anything not installed is
# skipped, which keeps this honest across image variants - the CLI image has no
# notebook extras, and language runtimes only exist in some of them.

set -u

show() {
    local name="$1"
    shift
    command -v "$name" >/dev/null 2>&1 || return 0
    local out
    out="$("$@" 2>&1 | grep -m1 -vE '^[[:space:]]*$' | cut -c1-100)"
    printf '  %-22s %s\n' "$name" "${out:-installed}"
}

echo "jsonnet"
show jsonnet jsonnet --version
show jrsonnet jrsonnet --version
show jsonnetfmt jsonnetfmt --version
show jb jb --version
show vendir vendir version

echo "dashboards"
show grr grr --version
show grafanactl grafanactl --version
show mixtool mixtool --version
show dashboard-linter dashboard-linter --help

echo "rules and SLOs"
show promtool promtool --version
show mimirtool mimirtool version
show lokitool lokitool version
show amtool amtool --version
show logcli logcli --version
show pint pint version
show sloth sloth version
show pyrra pyrra --version

echo "collection"
show alloy alloy --version
show kubectl kubectl version --client

echo "runtimes"
show python3 python3 --version
show go go version
show node node --version
show just just --version
show yq yq --version
show jq jq --version
