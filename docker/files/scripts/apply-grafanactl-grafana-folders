#!/bin/bash
# Ensure the folders app-platform dashboards are annotated with (legacy
# /api/folders: create, or update the title when it exists). A folder that
# names a parent in its grafana.app/folder annotation is nested under it -
# created with parentUid, and moved when it already exists elsewhere; one
# without the annotation is moved back to the root. Parents are applied
# first. Same auth env as apply-grafanactl-grafana-dashboards.

BUILD_DIR="${BUILD_DIR:=/build/default/grafanactl/grafana-folders}"

yaml_files=$(find "$BUILD_DIR" -maxdepth 1 -type f -name "*.yaml")
if [ -z "$yaml_files" ]; then echo "No *.yaml files found in '$BUILD_DIR'."; exit 0; fi
if [ -z "$GRAFANA_URL" ]; then echo "GRAFANA_URL not set, cannot connect to Grafana server."; exit 1; fi
if [ -n "$GRAFANA_TOKEN" ]; then AUTH=(-H "Authorization: Bearer $GRAFANA_TOKEN");
elif [ -n "$GRAFANA_USER" ] && [ -n "$GRAFANA_PASSWORD" ]; then AUTH=(-u "$GRAFANA_USER:$GRAFANA_PASSWORD");
else echo "Set GRAFANA_TOKEN or GRAFANA_USER + GRAFANA_PASSWORD."; exit 1; fi

apply_folder() {
  local yaml_file="$1"
  local uid title parent body
  uid=$(yq eval '.metadata.name' "$yaml_file")
  title=$(yq eval '.spec.title' "$yaml_file")
  parent=$(yq eval '.metadata.annotations."grafana.app/folder" // ""' "$yaml_file")
  if [ -n "$parent" ]; then
    body=$(jq -n --arg u "$uid" --arg t "$title" --arg p "$parent" '{uid:$u,title:$t,parentUid:$p}')
  else
    body=$(jq -n --arg u "$uid" --arg t "$title" '{uid:$u,title:$t}')
  fi
  code=$(curl -s -o /tmp/resp.json -w "%{http_code}" "${AUTH[@]}" -H "Content-Type: application/json" -X POST "$GRAFANA_URL/api/folders" -d "$body")
  case "$code" in
    200|201) echo "OK   folder $uid ($title)${parent:+ under $parent} created" ;;
    409|412)
      curl -s -o /dev/null "${AUTH[@]}" -H "Content-Type: application/json" -X PUT "$GRAFANA_URL/api/folders/$uid" -d "$(jq -n --arg t "$title" '{title:$t,overwrite:true}')"
      # keep an existing folder where the config says it belongs: under its
      # parent, or at the root for a top-level one ({"parentUid": ""}).
      live_parent=$(curl -s "${AUTH[@]}" "$GRAFANA_URL/api/folders/$uid" | jq -r '.parentUid // ""')
      if [ "$live_parent" = "$parent" ]; then
        echo "OK   folder $uid ($title)${parent:+ under $parent} exists"
      else
        code=$(curl -s -o /tmp/resp.json -w "%{http_code}" "${AUTH[@]}" -H "Content-Type: application/json" -X POST "$GRAFANA_URL/api/folders/$uid/move" -d "$(jq -n --arg p "$parent" '{parentUid:$p}')")
        if [ "$code" != 200 ]; then
          echo "FAIL folder $uid move from '${live_parent:-root}' HTTP $code: $(head -c 200 /tmp/resp.json)"
        elif [ -n "$parent" ]; then
          echo "OK   folder $uid ($title) moved under $parent"
        else
          # a folder moved to the root loses the grants it inherited from its
          # old parent - restore the usual role grants (needs the right to
          # set permissions on it; warn when these credentials lack it)
          for rp in Viewer:View Editor:Edit; do
            g=$(curl -s -o /dev/null -w "%{http_code}" "${AUTH[@]}" -H "Content-Type: application/json" -X POST "$GRAFANA_URL/api/access-control/folders/$uid/builtInRoles/${rp%:*}" -d "{\"permission\":\"${rp#*:}\"}")
            [ "$g" = 200 ] || echo "WARN folder $uid: could not grant ${rp%:*} ${rp#*:} after the move to the root (HTTP $g)"
          done
          echo "OK   folder $uid ($title) moved to the root"
        fi
      fi ;;
    *) echo "FAIL folder $uid HTTP $code: $(head -c 200 /tmp/resp.json)" ;;
  esac
}

# Parents before children at any depth: each pass applies the folders whose
# parent is not still waiting in this set (top level, applied in an earlier
# pass, or managed elsewhere). A tree three levels deep (Platform /
# Infrastructure / Compute) needs three passes; with only "top level first"
# a grandchild could be created before its parent and fail with 404.
declare -A uid_of parent_of
for yaml_file in $yaml_files; do
  uid_of[$yaml_file]=$(yq eval '.metadata.name' "$yaml_file")
  parent_of[$yaml_file]=$(yq eval '.metadata.annotations."grafana.app/folder" // ""' "$yaml_file")
done
pending=($yaml_files)
while [ ${#pending[@]} -gt 0 ]; do
  waiting=" "
  for yaml_file in "${pending[@]}"; do waiting+="${uid_of[$yaml_file]} "; done
  next=()
  for yaml_file in "${pending[@]}"; do
    parent=${parent_of[$yaml_file]}
    if [ -n "$parent" ] && [ "$parent" != "${uid_of[$yaml_file]}" ] && [[ "$waiting" == *" $parent "* ]]; then
      next+=("$yaml_file")
    else
      apply_folder "$yaml_file"
    fi
  done
  if [ ${#next[@]} -eq ${#pending[@]} ]; then
    # parent cycle: apply the rest as they are rather than loop forever
    for yaml_file in "${next[@]}"; do apply_folder "$yaml_file"; done
    break
  fi
  pending=("${next[@]}")
done
exit 0
