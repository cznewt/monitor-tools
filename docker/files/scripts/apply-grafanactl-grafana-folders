#!/bin/bash
# Ensure the folders app-platform dashboards are annotated with (legacy
# /api/folders: create, or update the title when it exists). A folder that
# names a parent in its grafana.app/folder annotation is nested under it -
# created with parentUid, and moved when it already exists. Parents are
# applied first. Same auth env as apply-grafanactl-grafana-dashboards.

BUILD_DIR="${BUILD_DIR:=/build/default/grafanactl/grafana-folders}"

yaml_files=$(find "$BUILD_DIR" -maxdepth 1 -type f -name "*.yaml")
if [ -z "$yaml_files" ]; then echo "No *.yaml files found in '$BUILD_DIR'."; exit 0; fi
if [ -z "$GRAFANA_URL" ]; then echo "GRAFANA_URL not set, cannot connect to Grafana server."; exit 1; fi
if [ -n "$GRAFANA_TOKEN" ]; then AUTH=(-H "Authorization: Bearer $GRAFANA_TOKEN");
elif [ -n "$GRAFANA_USER" ] && [ -n "$GRAFANA_PASSWORD" ]; then AUTH=(-u "$GRAFANA_USER:$GRAFANA_PASSWORD");
else echo "Set GRAFANA_TOKEN or GRAFANA_USER + GRAFANA_PASSWORD."; exit 1; fi

apply_folder() {
  local yaml_file="$1"
  local uid title parent body
  uid=$(yq eval '.metadata.name' "$yaml_file")
  title=$(yq eval '.spec.title' "$yaml_file")
  parent=$(yq eval '.metadata.annotations."grafana.app/folder" // ""' "$yaml_file")
  if [ -n "$parent" ]; then
    body=$(jq -n --arg u "$uid" --arg t "$title" --arg p "$parent" '{uid:$u,title:$t,parentUid:$p}')
  else
    body=$(jq -n --arg u "$uid" --arg t "$title" '{uid:$u,title:$t}')
  fi
  code=$(curl -s -o /tmp/resp.json -w "%{http_code}" "${AUTH[@]}" -H "Content-Type: application/json" -X POST "$GRAFANA_URL/api/folders" -d "$body")
  case "$code" in
    200|201) echo "OK   folder $uid ($title)${parent:+ under $parent} created" ;;
    409|412)
      curl -s -o /dev/null "${AUTH[@]}" -H "Content-Type: application/json" -X PUT "$GRAFANA_URL/api/folders/$uid" -d "$(jq -n --arg t "$title" '{title:$t,overwrite:true}')"
      # keep an existing folder where the config says it belongs
      [ -n "$parent" ] && curl -s -o /dev/null "${AUTH[@]}" -H "Content-Type: application/json" -X POST "$GRAFANA_URL/api/folders/$uid/move" -d "$(jq -n --arg p "$parent" '{parentUid:$p}')"
      echo "OK   folder $uid ($title)${parent:+ under $parent} exists" ;;
    *) echo "FAIL folder $uid HTTP $code: $(head -c 200 /tmp/resp.json)" ;;
  esac
}

# parents (no grafana.app/folder annotation) first, then the nested ones
for yaml_file in $yaml_files; do
  [ -z "$(yq eval '.metadata.annotations."grafana.app/folder" // ""' "$yaml_file")" ] && apply_folder "$yaml_file"
done
for yaml_file in $yaml_files; do
  [ -n "$(yq eval '.metadata.annotations."grafana.app/folder" // ""' "$yaml_file")" ] && apply_folder "$yaml_file"
done
exit 0
