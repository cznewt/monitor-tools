#!/bin/bash
# Push app-platform Dashboard resources (dashboard.grafana.app/v0alpha1 or
# v2beta1) through Grafana's Kubernetes-style API: create when absent, else
# update with the live resourceVersion. Auth: GRAFANA_TOKEN (Bearer) or
# GRAFANA_USER + GRAFANA_PASSWORD (basic).

BUILD_DIR="${BUILD_DIR:=/build/default/grafanactl/grafana-dashboards}"
GRAFANA_NAMESPACE="${GRAFANA_NAMESPACE:=default}"

yaml_files=$(find "$BUILD_DIR" -maxdepth 1 -type f -name "*.yaml")
if [ -z "$yaml_files" ]; then echo "No *.yaml files found in '$BUILD_DIR'."; exit 1; fi
if [ -z "$GRAFANA_URL" ]; then echo "GRAFANA_URL not set, cannot connect to Grafana server."; exit 1; fi
if [ -n "$GRAFANA_TOKEN" ]; then AUTH=(-H "Authorization: Bearer $GRAFANA_TOKEN");
elif [ -n "$GRAFANA_USER" ] && [ -n "$GRAFANA_PASSWORD" ]; then AUTH=(-u "$GRAFANA_USER:$GRAFANA_PASSWORD");
else echo "Set GRAFANA_TOKEN or GRAFANA_USER + GRAFANA_PASSWORD."; exit 1; fi

fail=0
for yaml_file in $yaml_files; do
  apiVersion=$(yq eval '.apiVersion' "$yaml_file")
  name=$(yq eval '.metadata.name' "$yaml_file")
  group=${apiVersion%/*}; version=${apiVersion#*/}
  base="$GRAFANA_URL/apis/$group/$version/namespaces/$GRAFANA_NAMESPACE/dashboards"
  live=$(curl -s -o /tmp/live.json -w "%{http_code}" "${AUTH[@]}" "$base/$name")
  if [ "$live" = "200" ]; then
    rv=$(jq -r '.metadata.resourceVersion // empty' /tmp/live.json)
    body=$(yq eval -o=json "$yaml_file" | jq --arg rv "$rv" '.metadata.resourceVersion = $rv')
    code=$(printf '%s' "$body" | curl -s -o /tmp/resp.json -w "%{http_code}" "${AUTH[@]}" -H "Content-Type: application/json" -X PUT "$base/$name" --data-binary @-)
  else
    body=$(yq eval -o=json "$yaml_file")
    code=$(printf '%s' "$body" | curl -s -o /tmp/resp.json -w "%{http_code}" "${AUTH[@]}" -H "Content-Type: application/json" -X POST "$base" --data-binary @-)
  fi
  if [ "$code" = "200" ] || [ "$code" = "201" ]; then
    echo "OK   $name ($apiVersion) -> $GRAFANA_URL/d/$name"
  else
    echo "FAIL $name ($apiVersion) HTTP $code: $(head -c 300 /tmp/resp.json)"; fail=1
  fi
done
exit $fail
