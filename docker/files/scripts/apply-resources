#!/bin/bash

CONFIG_FILE="${CONFIG_FILE:=/config/default.yaml}"
VENDOR_DIR="/scripts/vendor"

ENV_NAME=$(yq eval ".name" "$CONFIG_FILE")
grafana=$(yq eval ".grafana.render" "$CONFIG_FILE")
prometheus=$(yq eval ".prometheus.render" "$CONFIG_FILE")
loki=$(yq eval ".loki.render" "$CONFIG_FILE")
alertmanager=$(yq eval ".alertmanager.render" "$CONFIG_FILE")

# grafana resources
printf "\nApplying Grafana resources with $grafana processor...\n"

rc=0
if [ "$grafana" = "grizzly" ]; then 
  CONFIG_FILE=$CONFIG_FILE BUILD_DIR=/build/$ENV_NAME/grizzly/grafana-folders apply-grizzly-grafana-folders || rc=1
  CONFIG_FILE=$CONFIG_FILE BUILD_DIR=/build/$ENV_NAME/grizzly/grafana-library-panels apply-grizzly-grafana-library-panels || rc=1
  CONFIG_FILE=$CONFIG_FILE BUILD_DIR=/build/$ENV_NAME/grizzly/grafana-dashboards apply-grizzly-grafana-dashboards || rc=1
fi
if [ "$grafana" = "grafanactl" ]; then
  CONFIG_FILE=$CONFIG_FILE BUILD_DIR=/build/$ENV_NAME/grafanactl/grafana-folders apply-grafanactl-grafana-folders || rc=1
  CONFIG_FILE=$CONFIG_FILE BUILD_DIR=/build/$ENV_NAME/grafanactl/grafana-dashboards apply-grafanactl-grafana-dashboards || rc=1
fi

# prometheus resources
printf  "\nApplying Prometheus resources with $prometheus processor...\n"
if [ "$prometheus" = "mimirtool" ]; then
  CONFIG_FILE=$CONFIG_FILE BUILD_DIR=/build/$ENV_NAME/mimirtool/mimir-rules apply-mimirtool-mimir-rules || rc=1
fi

# loki resources
printf  "\nApplying Loki resources with $loki processor...\n"
if [ "$loki" = "lokitool" ]; then
  CONFIG_FILE=$CONFIG_FILE BUILD_DIR=/build/$ENV_NAME/lokitool/loki-rules apply-lokitool-loki-rules || rc=1
fi
if [ "$loki" = "configmap" ]; then
  CONFIG_FILE=$CONFIG_FILE BUILD_DIR=/build/$ENV_NAME/configmap/loki-rules apply-configmap-loki-rules || rc=1
fi

# alertmanager resources
printf  "\nApplying Alertmanager resources with $alertmanager processor...\n"

if [ "$alertmanager" = "mimirtool" ]; then 
  CONFIG_FILE=$CONFIG_FILE BUILD_DIR=/build/$ENV_NAME/mimirtool/alertmanager-config apply-mimirtool-alertmanager-config || rc=1
fi
exit $rc
