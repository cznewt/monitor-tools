#!/bin/bash

BUILD_DIR="${BUILD_DIR:=/build/default/grizzly/grafana-folders}"

yaml_files=$(find "$BUILD_DIR" -maxdepth 1 -type f -name "*.yaml")

fail=0
if [ -z "$yaml_files" ]; then echo "No *.yaml files in '$BUILD_DIR', nothing to apply."; exit 0; fi

if [ -z "$GRAFANA_URL" ]; then echo "GRAFANA_URL not set, cannot connect to Grafana server."; exit 1; fi
if [ -z "$GRAFANA_TOKEN" ]; then echo "GRAFANA_TOKEN not set, cannot connect to Grafana server."; exit 1; fi

for yaml_file in $yaml_files; do
  echo "Applying $yaml_file grizzly GrafanaFolders to $GRAFANA_URL..."
  grr apply $yaml_file --disable-reporting || fail=1
done
exit $fail
